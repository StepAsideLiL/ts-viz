{
  "name": "ts-viz",
  "version": "1.0.0",
  "description": "Interactive TypeScript code visualizer: call graph, types and live execution tracing.",
  "type": "module",
  "bin": {
    "ts-viz": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "src",
    "public"
  ],
  "dependencies": {
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
